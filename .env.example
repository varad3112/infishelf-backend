# ==============================================================================
# InfiShelf Backend - Environment Configuration Template
# Duplicate this file as .env and populate your actual values.
# NEVER commit your real .env file to Git.
# ==============================================================================

# Django Core Settings
SECRET_KEY=django-insecure-replace-with-a-secure-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# ------------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL / SQLite fallback)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection URI (direct or session pooler):
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Google Gemini / GenAI Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated frontend domains)
# Note: *.vercel.app and *.netlify.app are automatically permitted by regex in settings.py
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://infishelf.vercel.app,https://infishelf.netlify.app

# ------------------------------------------------------------------------------
# Cache Configuration (Optional - defaults to LocMemCache if not provided)
# ------------------------------------------------------------------------------
# REDIS_URL=rediss://default:password@your-upstash-or-render-redis.com:6379

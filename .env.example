# ==============================================================================
# InfiShelf Backend - Environment Configuration Template
# Duplicate this file as .env and populate your actual values.
# NEVER commit your real .env file to Git.
# ==============================================================================

# Django Core Settings
SECRET_KEY=django-insecure-replace-with-a-secure-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL / SQLite fallback)
# ------------------------------------------------------------------------------
# Option A: Full Connection URI (Recommended for Supabase)
# For direct connection (Port 5432):
# postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Or for Supabase Transaction Pooler (Port 6543):
# postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres?sslmode=require



# ------------------------------------------------------------------------------
# Google Gemini / GenAI Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
